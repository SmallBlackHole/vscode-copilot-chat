# Azure OpenAI Configuration
# Replace these values with your actual Azure OpenAI endpoint and deployment name

# Your Azure OpenAI endpoint URL (e.g., https://your-resource.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=<azure_openai_endpoint>

# Your Azure OpenAI deployment name (the name you gave to your model deployment)
AZURE_OPENAI_DEPLOYMENT_NAME=<azure_openai_deployment_name>
